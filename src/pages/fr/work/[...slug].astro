---
import { getCollection } from 'astro:content';
import WorkDetail from '../../../components/WorkDetail.astro';
import { getLocalizedPath, useTranslations } from '../../../utils/i18n';

const t = useTranslations('fr');

export async function getStaticPaths() {
	const work = await getCollection('work');

	return work
		.filter((entry) => entry.data.locale === 'fr')
		.map((entry) => ({
			params: {
				slug: entry.id.replace(/\/fr$/, ''),
			},
			props: {
				entry,
			},
		}));
}

const { entry } = Astro.props;
---

<WorkDetail
	entry={entry}
	backHref={getLocalizedPath('/work/', 'fr')}
	backLabel={t.navigation.work}
/>
