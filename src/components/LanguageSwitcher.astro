---
const pathname = Astro.url.pathname;
const isFrench = pathname.startsWith('/fr');

const englishUrl = pathname.replace(/^\/fr/, '') || '/';
const frenchUrl = isFrench ? pathname : `/fr${pathname === '/' ? '' : pathname}`;

const currentLocale = isFrench ? 'fr' : 'en';
---

<nav class="language-switcher" aria-label="Language">
	<a
		href={englishUrl}
		class:list={{ active: currentLocale === 'en' }}
		aria-current={currentLocale === 'en' ? 'page' : undefined}
	>
		EN
	</a>

	<a
		href={frenchUrl}
		class:list={{ active: currentLocale === 'fr' }}
		aria-current={currentLocale === 'fr' ? 'page' : undefined}
	>
		FR
	</a>
</nav>

<style>
	.language-switcher {
		display: inline-flex;
		align-items: center;
		gap: 0.125rem;
		padding: 0.25rem;
		border: 1px solid var(--gray-800);
		border-radius: 999rem;
		background: radial-gradient(var(--gray-900), var(--gray-800) 150%);
		font-family: var(--font-brand);
		font-size: var(--text-xs);
		font-weight: 600;
		line-height: 1;
	}

	.language-switcher a {
		display: flex;
		align-items: center;
		justify-content: center;
		min-width: 2rem;
		height: 1.75rem;
		padding-inline: 0.5rem;
		border-radius: 999rem;
		color: var(--gray-400);
		text-decoration: none;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition),
			transform var(--theme-transition);
	}

	.language-switcher a:hover,
	.language-switcher a:focus-visible {
		color: var(--gray-100);
	}

	.language-switcher a.active {
		color: var(--accent-text-over);
		background-color: var(--accent-regular);
	}

	.language-switcher a:focus-visible {
		outline: 2px solid var(--accent-regular);
		outline-offset: 2px;
	}
</style>
