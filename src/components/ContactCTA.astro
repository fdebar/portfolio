---
import track from '../utils/track';
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import { useTranslations, getAssetPath } from '../utils/i18n';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);

const email = 'flavien.debar@gmail.com';
---

<aside>
	<div class="content">
		<div class="contact">
			<h2>{t.contact.title}</h2>

			<div class="email-wrapper">
				<a class="email" href={`mailto:${email}`} data-analytics="contact_click">
					{email}
				</a>

				<button
					class="copy-button"
					type="button"
					data-copy-email={email}
					data-copy-label={t.contact.copy}
					data-copied-label={t.contact.copied}
					data-copy-error={t.contact.copyError}
					data-analytics="contact_click"
					aria-label={t.contact.copy}
					title={t.contact.copy}
				>
					<span class="copy-icon" aria-hidden="true">
						<Icon icon="copy" size="1.1em" />
					</span>
					<span class="copy-label">{t.contact.copy}</span>
				</button>
			</div>
		</div>

		<div class="resume-links">
			<span>{t.contact.resume}</span>

			<div class="links">
				<a
					href={getAssetPath('cv/Flavien-Debar-CV-EN.pdf')}
					download
					data-analytics="resume_download"
				>
					<Icon icon="file-pdf" size="1em" />
					English CV
				</a>

				<span class="separator">·</span>

				<a
					href={getAssetPath('cv/Flavien-Debar-CV-FR.pdf')}
					download
					data-analytics="resume_download"
				>
					<Icon icon="file-pdf" size="1em" />
					CV français
				</a>
			</div>
		</div>
	</div>
</aside>

<script>
	const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-email]');

	copyButton?.addEventListener('click', async () => {
		const email = copyButton.dataset.copyEmail;
		const label = copyButton.querySelector('.copy-label');
		const icon = copyButton.querySelector('svg');
		const copyLabel = copyButton.dataset.copyLabel;
		const copiedLabel = copyButton.dataset.copiedLabel;
		const copyError = copyButton.dataset.copyError;

		if (!email) return;

		try {
			await navigator.clipboard.writeText(email);

			if (label) label.textContent = copiedLabel;
			copyButton.classList.add('copied');

			if (icon) {
				icon.outerHTML = `
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="1.1em"
						height="1.1em"
						fill="currentColor"
						viewBox="0 0 256 256"
					>
						<path d="M229.66,77.66l-128,128a8,8,0,0,1-11.32,0l-56-56a8,8,0,0,1,11.32-11.32L96,188.69,218.34,66.34a8,8,0,0,1,11.32,11.32Z"></path>
					</svg>
				`;
			}

			setTimeout(() => {
				if (label) label.textContent = copyLabel;
				copyButton.classList.remove('copied');
			}, 2000);
		} catch {}
	});
</script>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.content {
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		gap: 2.5rem;
	}

	.contact {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	.email-wrapper {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		position: relative;
	}

	.email {
		display: inline-flex;
		align-items: center;
		color: var(--gray-100);
		font-size: var(--text-lg);
		font-weight: 500;
		text-decoration: none;
		transition:
			color 0.2s ease,
			transform 0.2s ease;
	}

	.email:hover {
		color: var(--accent);
	}

	.email:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 4px;
		border-radius: 0.25rem;
	}

	.copy-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.45rem;
		min-width: 5.5rem;
		min-height: 2.5rem;
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--gray-700);
		border-radius: 999px;
		background: var(--gray-900);
		color: var(--gray-300);
		font: inherit;
		font-size: var(--text-xs);
		font-weight: 600;
		cursor: pointer;
		box-shadow: var(--shadow-sm);
		transition:
			transform 0.2s ease,
			border-color 0.2s ease,
			background-color 0.2s ease,
			color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.copy-button:hover {
		transform: translateY(-1px);
		border-color: var(--accent);
		background: var(--gray-800);
		color: var(--gray-100);
		box-shadow: var(--shadow-md);
	}

	.copy-button:active {
		transform: translateY(0);
		box-shadow: var(--shadow-sm);
	}

	.copy-button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.copy-button.copied {
		border-color: var(--accent);
		background: var(--gray-800);
		color: var(--accent);
	}

	.copy-button.error {
		border-color: var(--gray-600);
		color: var(--gray-200);
	}

	.copy-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 1rem;
		height: 1rem;
	}

	.copy-label {
		white-space: nowrap;
	}

	.resume-links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.resume-links > span {
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.links a {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--gray-200);
		text-decoration: none;
		transition: opacity 0.2s ease;
	}

	.links a:hover {
		opacity: 0.8;
	}

	.separator {
		color: var(--gray-500);
	}

	@media (min-width: 50em) {
		aside {
			padding: 3rem 5rem;
		}

		.content {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}

		.contact {
			align-items: flex-start;
		}

		h2 {
			font-size: var(--text-2xl);
			text-align: left;
		}

		.email-wrapper {
			justify-content: flex-start;
		}

		.resume-links {
			align-items: flex-end;
		}
	}
</style>
