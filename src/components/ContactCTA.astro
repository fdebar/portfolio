---
import CallToAction from './CallToAction.astro';
import Icon from './Icon.astro';
import { useTranslations } from '../utils/i18n';

const locale = Astro.currentLocale ?? 'en';
const t = useTranslations(locale);
---

<aside>
	<div class="content">
		<h2>{t.contact.title}</h2>

		<div class="actions">
			<CallToAction href="mailto:flavien.debar@gmail.com">
				{t.contact.button}
				<Icon icon="paper-plane-tilt" size="1.2em" />
			</CallToAction>

			<div class="resume-links">
				<span>{t.contact.resume}</span>

				<div class="links">
					<a href="/assets/cv/Flavien-Debar-CV-EN.pdf" download>
						<Icon icon="file-pdf" size="1em" />
						English CV
					</a>

					<span class="separator">·</span>

					<a href="/assets/cv/Flavien-Debar-CV-FR.pdf" download>
						<Icon icon="file-pdf" size="1em" />
						CV français
					</a>
				</div>
			</div>
		</div>
	</div>
</aside>

<style>
	aside {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 3rem;
		border-top: 1px solid var(--gray-800);
		border-bottom: 1px solid var(--gray-800);
		padding: 5rem 1.5rem;
		background-color: var(--gray-999_40);
		box-shadow: var(--shadow-sm);
	}

	.content {
		display: flex;
		flex-direction: column;
		width: 100%;
		gap: 3rem;
	}

	h2 {
		font-size: var(--text-xl);
		text-align: center;
		max-width: 15ch;
	}

	.actions {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}

	.resume-links {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.resume-links span {
		color: var(--gray-400);
		font-size: var(--text-sm);
	}

	.links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.links a {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		text-decoration: none;
		color: var(--gray-200);
		transition: opacity 0.2s ease;
	}

	.links a:hover {
		opacity: 0.8;
	}

	.separator {
		color: var(--gray-500);
	}

	@media (min-width: 50em) {
		aside {
			padding: 3rem 5rem;
		}

		.content {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}

		h2 {
			font-size: var(--text-2xl);
			text-align: left;
		}
	}
</style>
